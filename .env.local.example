# ─────────────────────────────────────────────────
# Spicer OS — Environment Variables
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────
# Get from: supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key  # NEVER expose to client

# ── Notion ────────────────────────────────────────
# Get from: notion.so/my-integrations → Create integration
# Then share each DB below with that integration.
NOTION_API_KEY=secret_your_notion_api_key

# Database IDs (pre-filled from your workspace — verify these are correct)
NOTION_LOG_DB_ID=1ec70a46-f264-801e-8af5-e57aa2b154f6
NOTION_WORKOUT_DB_ID=1ec70a46-f264-8036-a033-f69ca756137c
NOTION_GOALS_DB_ID=2e670a46-f264-803b-b196-000b710f55a0
NOTION_SV_VIDEOS_DB_ID=a583175d-7d64-4f79-8580-83c0fec1bf61
NOTION_ACCOUNTS_DB_ID=2e570a46-f264-8099-8832-000b4d811395
NOTION_LEDGER_DB_ID=2e670a46-f264-80ad-be93-000b76dacb5c

# ── Plaid ─────────────────────────────────────────
# Get from: plaid.com/developers → Team Settings → Keys
# Start with PLAID_ENV=sandbox for testing
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox  # Change to 'production' after approval

# ── Email Alerts (Resend) ─────────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY=re_your_resend_api_key
ALERT_EMAIL=aaronwspicer@spicervisions.online

# ── App ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000  # Change to your production URL when deploying
FRAUD_ALERT_THRESHOLD_CAD=150

# ── Owner & Brand (src/config.ts) ─────────────────
# These make the OS "yours" instead of Aaron's. All optional — sensible
# defaults exist. The setup CLI (npm run init) fills these for you.
NEXT_PUBLIC_OWNER_NAME=Aaron                       # your first name (greetings, Alfred)
NEXT_PUBLIC_OWNER_FULL_NAME=Aaron Spicer
OWNER_EMAIL=aaronwspicer@spicervisions.online      # where alert/brief emails go
NEXT_PUBLIC_BRAND_NAME=SpicerVisions OS
NEXT_PUBLIC_BRAND_SHORT_NAME=Spicer OS
NEXT_PUBLIC_BRAND_TAGLINE=Personal Life System
NEXT_PUBLIC_APP_DOMAIN=spicervisions.online        # bare domain (no https://)
EMAIL_FROM=Spicer OS <hello@yourdomain.com>        # verified Resend sender

# ── Locale (src/config.ts) — the setup wizard asks these ──
NEXT_PUBLIC_TIMEZONE=America/Toronto               # IANA tz — drives "today"/streaks/cron
NEXT_PUBLIC_LOCALE=en-CA                           # BCP-47 — date/number formatting
NEXT_PUBLIC_CURRENCY=CAD                           # ISO 4217 — money display
NEXT_PUBLIC_WEATHER_LAT=43.6532                    # home coords for weather widget
NEXT_PUBLIC_WEATHER_LON=-79.3832
NEXT_PUBLIC_WEATHER_LABEL=Toronto

# ── Feature toggles (src/config.ts) ───────────────
# Set to "false" to disable. Default on. Flip off the personal/regional ones.
NEXT_PUBLIC_FEATURE_JAYS=true                      # Toronto Blue Jays widget (very personal)
NEXT_PUBLIC_FEATURE_TAX_YEAR=true                  # Canadian tax-year ledger relation
NEXT_PUBLIC_FEATURE_WORKOUT=true                   # Workout Notion DB
NEXT_PUBLIC_FEATURE_FINANCE_VAULT=true             # bank CSV + finance vault (opt-in, sensitive)

# ── Security ──────────────────────────────────────
# Run: openssl rand -base64 32
ENCRYPTION_KEY=your_32_byte_encryption_key_for_plaid_tokens

# ── Cron ──────────────────────────────────────────
# Required for Vercel cron to authenticate against /api/cron/*
# Run: openssl rand -base64 32
CRON_SECRET=your_random_cron_secret

# ── Observability (Sentry) ────────────────────────
# Get from: sentry.io → Project Settings → SDK Setup → Client Keys (DSN)
# Leave unset locally to disable Sentry. Set both in Vercel for prod.
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
SENTRY_DSN=your_sentry_dsn
# Optional — required for source-map upload at build time so prod stack traces are readable
SENTRY_ORG=your_sentry_org_slug
SENTRY_PROJECT=spicer-os
SENTRY_AUTH_TOKEN=your_sentry_auth_token
